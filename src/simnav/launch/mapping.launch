<launch>
  <arg name="cloud_topic" default="/livox/Pointcloud2"/>
  <arg name="scan_topic" default="/scan_2d"/>
  <arg name="team_scene_info" default="/workspace/SimEnv/generated_building/team_scene_info.json"/>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="simnav_cloud_to_scan" output="screen">
    <remap from="cloud_in" to="$(arg cloud_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="target_frame" value="base"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="0.08"/>
    <param name="max_height" value="1.50"/>
    <param name="angle_min" value="-3.14159265"/>
    <param name="angle_max" value="3.14159265"/>
    <param name="angle_increment" value="0.00872665"/>
    <param name="scan_time" value="0.10"/>
    <param name="range_min" value="0.20"/>
    <param name="range_max" value="12.0"/>
    <param name="use_inf" value="true"/>
    <param name="concurrency_level" value="1"/>
  </node>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="map_frame" value="simnav_map"/>
    <param name="base_frame" value="base"/>
    <param name="odom_frame" value="simnav_odom"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="pub_map_odom_transform" value="false"/>
    <param name="pub_map_scanmatch_transform" value="true"/>
    <param name="tf_map_scanmatch_transform_frame_name" value="scanmatcher_frame"/>
    <param name="map_resolution" value="0.05"/>
    <param name="map_size" value="1024"/>
    <param name="map_start_x" value="0.5"/>
    <param name="map_start_y" value="0.25"/>
    <param name="map_multi_res_levels" value="2"/>
    <param name="scan_subscriber_queue_size" value="1"/>
    <param name="map_update_distance_thresh" value="0.10"/>
    <param name="map_update_angle_thresh" value="0.05"/>
    <param name="map_pub_period" value="0.5"/>
    <param name="laser_min_dist" value="0.20"/>
    <param name="laser_max_dist" value="12.0"/>
  </node>

  <node pkg="simnav" type="localization_bridge_node.py" name="localization_bridge" output="screen">
    <param name="team_scene_info" value="$(arg team_scene_info)"/>
    <param name="base_height" value="0.265"/>
  </node>

  <node pkg="simnav" type="map_views_node.py" name="map_views" output="screen">
    <param name="mapping_frequency" value="2.0"/>
    <param name="small_gap_kernel" value="5"/>
  </node>
</launch>
