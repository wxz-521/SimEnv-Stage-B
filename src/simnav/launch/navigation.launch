<launch>
  <node pkg="move_base" type="move_base" name="move_base" output="screen" clear_params="true">
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
    <param name="controller_frequency" value="10.0"/>
    <param name="planner_frequency" value="1.0"/>
    <param name="planner_patience" value="5.0"/>
    <param name="controller_patience" value="8.0"/>
    <param name="oscillation_timeout" value="8.0"/>
    <param name="oscillation_distance" value="0.10"/>
    <param name="recovery_behavior_enabled" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
    <rosparam command="load" file="$(find simnav)/config/costmap_common.yaml" ns="global_costmap"/>
    <rosparam command="load" file="$(find simnav)/config/costmap_common.yaml" ns="local_costmap"/>
    <rosparam command="load" file="$(find simnav)/config/global_costmap.yaml"/>
    <rosparam command="load" file="$(find simnav)/config/local_costmap.yaml"/>
    <rosparam command="load" file="$(find simnav)/config/dwa.yaml"/>
  </node>
</launch>
