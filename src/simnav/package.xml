<?xml version="1.0"?>
<package format="2">
  <name>simnav</name>
  <version>0.1.0</version>
  <description>ROS1 single-floor mapping and room-oriented exploration for SimEnv.</description>
  <maintainer email="maintainer@example.com">SimEnv maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>building_generator_interfaces</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>
  <depend>move_base_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>rospkg</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>hector_mapping</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rviz</exec_depend>
</package>
